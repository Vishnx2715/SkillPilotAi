# Production environment template - DO NOT COMMIT ACTUAL VALUES
# These will be set as environment variables in Render

PROJECT_NAME=Skill Pilot AI
ENVIRONMENT=production

# Database - automatically provided by Render
# DATABASE_URL will be injected by Render from the database connection string

# Secret key - auto-generated by Render
# SECRET_KEY will be auto-generated

# CORS - update with your actual frontend URL
BACKEND_CORS_ORIGINS=https://skillpilot-frontend.onrender.com,http://localhost:3000

# xAI Grok - SET THIS IN RENDER DASHBOARD
XAI_API_KEY=your-grok-api-key-here
XAI_MODEL=grok-2-1212

# File uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=/tmp/uploads
