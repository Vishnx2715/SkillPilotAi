PROJECT_NAME=Skill Pilot AI
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=skillpilot_hackathon_super_secret_jwt_key_change_in_production_32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database — leave blank to run without DB (AI features work, auth/profiles need DB)
# Local dev with SQLite:  DATABASE_URL=sqlite+aiosqlite:///./skillpilot.db
# Supabase (add later):   DATABASE_URL=postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# xAI Grok (primary AI provider)
# Get your key from: https://console.x.ai
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-1212
AI_TIMEOUT_SECONDS=25

SECURE_COOKIE=False
PYTHON_EXECUTION_API_URL=
PYTHON_EXECUTION_API_KEY=
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
